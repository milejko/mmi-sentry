{
    "name": "mmi/mmi-sentry",
    "description": "MMi Sentry plugin",
    "keywords": ["sentry", "mmi"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mariusz Miłejko",
            "email": "mariusz@milejko.pl"
        }
    ],
    "require": {
        "sentry/sdk": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MmiSentry\\": "src/MmiSentry",
            "": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.4-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
